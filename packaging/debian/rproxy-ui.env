# rproxy-ui の設定（systemd の EnvironmentFile）。変更したら systemctl restart rproxy-ui。
# 項目の説明は /usr/share/doc/rproxy-ui/README.md。

# 待ち受け（既定はこのホストからだけ。rproxy の固定ルールで dashboard.example を 443 → 127.0.0.1:3000 に向けるなど）
HOSTNAME=127.0.0.1
PORT=3000

# NextAuth。NEXTAUTH_URL は利用者がブラウザで開く URL（Keycloak の Valid redirect URIs に ${NEXTAUTH_URL}/api/auth/callback/keycloak を登録する）
NEXTAUTH_URL=
# インストール時に生成する
NEXTAUTH_SECRET=

# Keycloak
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=rproxy-ui
KEYCLOAK_CLIENT_SECRET=

# MariaDB（テーブルは /usr/share/rproxy-ui/db/schema.sql で作る）
DB_HOST=
DB_PORT=3306
DB_DATABASE=rproxy
DB_USER=rproxy_ui
DB_PASSWORD=

# rproxy-api の制御 API（同じホストに rproxy-api があれば、インストール時に URL とトークンのファイルを入れる）
# Unix ソケット（rproxy の RPROXY_API_SOCKET）なら RPROXY_API_URL=unix:/run/rproxy/api.sock。
# rproxy-ui はグループ rproxy に入っている（SupplementaryGroups=rproxy）ので、ソケット（既定でモード 660）は
# rproxy の RPROXY_API_SOCKET_GROUP を rproxy にすれば使える
# rproxy のトークンファイルを権限付き（YAML）にするなら、このトークンに rules:read と rules:write のスコープを付ける
# （metrics:read は不要）。sha256 は printf %s "$TOKEN" | sha256sum で作る
RPROXY_API_URL=
# トークンそのもの、またはトークンを 1 行目に書いたファイル（RPROXY_API_TOKEN が優先。ファイルは書き換えれば次の問い合わせから使う。
# 同じホストの rproxy-api の /etc/rproxy/tokens（root:rproxy 0640）はグループ rproxy で読める）
RPROXY_API_TOKEN=
RPROXY_API_TOKEN_FILE=
# https:// の制御 API にクライアント証明書（mTLS。rproxy-api v0.4）で接続するとき（RPROXY_API_TLS_CA は rproxy の証明書を確かめる CA）
# RPROXY_API_TLS_CERT=/etc/rproxy-ui/tls/client.pem
# RPROXY_API_TLS_KEY=/etc/rproxy-ui/tls/client.key
# RPROXY_API_TLS_CA=/etc/rproxy-ui/tls/rproxy-ca.pem

# 利用量の集計（#101。先に /usr/share/rproxy-ui/db/migrations/010_usage.sql と 011_usage_attr.sql を適用する）：間隔（秒。0 で止める）と残す日数
# RPROXY_UI_USAGE_SECS=300
# RPROXY_UI_USAGE_HOURLY_DAYS=32
# RPROXY_UI_USAGE_DAILY_DAYS=400

# 複数の rproxy（ノードとグループ。README の「複数の rproxy（ノードとグループ）」）。指定すると上の 2 つは使わない。
# 先に /usr/share/rproxy-ui/db/migrations/006_nodes.sql・007_log_node.sql・008_overrides.sql・009_rproxy_rules.sql を適用し、ノードごとのビューを db/node-view.mjs で作る
# RPROXY_UI_NODES=/etc/rproxy-ui/nodes.yaml
# RPROXY_UI_USER_NODES=node1          # rproxy-user が触れるノード（既定は制限なし）
# act / stb（#109）：stb を DB の定義に揃える自動の送り直しの間隔（秒。既定 30、0 で止める）と、
# keepalived のスクリプトが使うトークンのファイル（/usr/share/doc/rproxy-ui/examples/keepalived/）
# RPROXY_UI_HA_SYNC_SECS=30
# RPROXY_UI_HA_TOKEN_FILE=/etc/rproxy-ui/ha.tokens

# ロール（README の「ロール」）。rproxy-admin はすべてのルール、ほかの人は自分のルールだけ
# RPROXY_UI_ROLES_CLAIM=realm_access.roles
# RPROXY_UI_ADMIN_ROLE=rproxy-admin
# RPROXY_UI_USER_ROLE=rproxy-user   # 付けると、このロールのない利用者は使えない（既定は空＝サインインできる人はだれでも）
# RPROXY_UI_USER_PORTS=1024-65535   # rproxy-user が使える待ち受けポート（既定は制限なし）
