# installed by the Debian package; override with systemctl edit rproxy-ui
[Unit]
Description=rproxy-ui (web UI for rproxy-api)
Wants=network-online.target
After=network-online.target rproxy-api.service mariadb.service

[Service]
Type=simple
User=rproxy-ui
Group=rproxy-ui
# rproxy-api's files that the UI may read (its token file, a control API socket, client certificates) are
# rproxy-api:rproxy and group-readable; the postinst creates the group and adds rproxy-ui to it
SupplementaryGroups=rproxy
Environment=NODE_ENV=production
# NEXTAUTH_*, KEYCLOAK_*, DB_*, RPROXY_API_*, HOSTNAME, PORT
EnvironmentFile=/etc/rproxy-ui/rproxy-ui.env
WorkingDirectory=/usr/lib/rproxy-ui
ExecStart=/usr/bin/node /usr/lib/rproxy-ui/server.js
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# the UI needs no capabilities, devices or kernel interfaces (#164). Address families: TCP/UDP, the control API's
# Unix socket, and netlink (os.networkInterfaces() for the addresses users may not forward to).
# MemoryDenyWriteExecute is left out: Node.js's JIT needs writable and executable memory
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Next.js writes its cache under .next/cache (a symlink to /var/cache/rproxy-ui)
CacheDirectory=rproxy-ui
CacheDirectoryMode=0750

[Install]
WantedBy=multi-user.target
